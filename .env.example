# ---- Core ----
# App runtime connection. In production (Supabase) use the POOLED connection (PgBouncer,
# port 6543) so serverless functions don't exhaust connections.
DATABASE_URL="postgresql://user:pass@localhost:5432/mckinney?schema=public"
# Direct (non-pooled) connection used ONLY by Prisma migrate/validate/db push. In production
# (Supabase) use the DIRECT connection (port 5432); PgBouncer cannot run migrations. Locally
# and in CI this is the same as DATABASE_URL. Required for `prisma validate`, `prisma migrate
# deploy`, and `prisma db push`.
DIRECT_URL="postgresql://user:pass@localhost:5432/mckinney?schema=public"
NEXT_PUBLIC_SITE_URL="https://mckinneysda.org"
TZ="America/Chicago"

# ---- Auth ----
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ---- Field encryption (32 bytes, base64) for pastoral/prayer/board-minutes ----
ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# ---- HMAC for unsubscribe + transfer-status tokens ----
TOKEN_HMAC_SECRET="generate-with: openssl rand -base64 32"

# ---- Email (Resend) ----
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
MAIL_FROM="McKinney SDA <noreply@mckinneysda.org>"

# ---- Cron ----
CRON_SECRET="generate-with: openssl rand -base64 32"

# ---- Uploads (S3 / Vercel Blob) ----
BLOB_READ_WRITE_TOKEN=""

# ---- External (giving is a redirect only; no card handling) ----
ADVENTIST_GIVING_URL="https://adventistgiving.org/donate/XXXXXX"

# ---- Building Project cinematic film (optional) ----
# Leave unset to use the local file at public/video/building-cinematic.mp4 (see the
# README there). Set this to an externally hosted film URL to override the local file.
BUILDING_CINEMATIC_URL=""
