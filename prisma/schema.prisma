// McKinney SDA Church Platform — Prisma schema (Master Plan v4, §5)
// Generated from the spec of record. Do not hand-edit models without updating the plan.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===== Enums =====
enum Role {
  MEMBER
  MINISTRY_HEAD
  ELDER
  CLERK
  TREASURER
  ADMIN
  PASTOR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ContentVisibility {
  PUBLIC
  MEMBERS_ONLY
}

// ===== Calendar / governed events (§Calendar) =====
// The Event lifecycle is richer than the generic ApprovalStatus used by Announcements, so the
// calendar has its own explicit, server-enforced state machine (src/lib/event-workflow.ts).
// Approval and publication are DISTINCT: an event can be APPROVED without being PUBLISHED.
enum EventStatus {
  DRAFT // department head is still preparing it (private)
  SUBMITTED // sent to admin, awaiting triage
  UNDER_REVIEW // admin is actively reviewing
  CHANGES_REQUESTED // admin returned it to the department head with comments
  APPROVED // admin approved; not yet publicly visible
  PUBLISHED // publicly visible on the website calendar
  REJECTED // admin declined it (terminal, retains history)
  CANCELLED // a scheduled event was called off (retains history)
  ARCHIVED // withdrawn/retired from active surfaces (retains history)
}

// Semantic category chosen by the submitter. Drives the public calendar's color/icon system;
// falls back to the ministry-slug mapping for legacy events with no explicit category.
enum EventCategory {
  WORSHIP
  YOUTH
  CHILDREN
  FAMILY
  OUTREACH
  HEALTH
  FELLOWSHIP
  SERVICE
  OTHER
}

// Where an event physically/virtually happens. The submission form reveals only the fields
// relevant to the chosen type.
enum LocationType {
  CHURCH // the church's regular meeting location
  EXTERNAL // an external physical venue
  ONLINE // online only
  HYBRID // in-person + online
}

// Board-approval verification state for events that require church-board sign-off. A department
// head ENTERS this for admin VERIFICATION; entering "APPROVED" never auto-publishes an event.
enum BoardApprovalState {
  PENDING
  APPROVED
  NOT_APPROVED
}

enum VisitorStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum SuppressionScope {
  GLOBAL
  MARKETING
}

enum SuppressionReason {
  USER_UNSUBSCRIBE
  HARD_BOUNCE
  SPAM_COMPLAINT
  ADMIN
  MINOR
  MISSING_CONSENT
}

enum EmailType {
  TRANSACTIONAL
  MARKETING
}

enum EmailStatus {
  QUEUED
  ACCEPTED
  DELIVERED
  DELAYED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED
  UNSUBSCRIBED
}

enum DocumentVisibility {
  PUBLIC
  MEMBERS_ONLY
  ADMIN_ONLY
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum JobStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum CareAlertStatus {
  OPEN
  ASSIGNED
  RESOLVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ===== Identity & auth =====
model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailNormalized String    @unique
  passwordHash    String
  role            Role      @default(MEMBER) // legacy single role; kept for back-compat during migration
  primaryRole     Role? // preferred default portal; falls back to `role` when null
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String? // encrypted at rest
  sessionVersion  Int       @default(0) // bump to revoke all sessions
  activatedAt     DateTime? // set when an invited user accepts (scaffold delta vs v4 §5)
  disabledAt      DateTime? // admin-disabled login; set = sign-in blocked (distinct from "never activated")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ministryId    String?
  ministry      Ministry?  @relation("MinistryMembers", fields: [ministryId], references: [id])
  ministriesLed Ministry[] @relation("MinistryLeader")
  member        Member?    @relation("MemberUser")

  announcementsCreated  Announcement[]       @relation("AnnouncementCreatedBy")
  announcementsReviewed Announcement[]       @relation("AnnouncementReviewedBy")
  eventsCreated         Event[]              @relation("EventCreatedBy")
  eventsReviewed        Event[]              @relation("EventReviewedBy")
  eventReviews          EventReview[]        @relation("EventReviewActor")
  prayerReviewed        PrayerRequest[]      @relation("PrayerReviewedBy")
  invitesSent           Invite[]             @relation("InviteInvitedBy")
  campaignsCreated      EmailCampaign[]      @relation("CampaignCreatedBy")
  careAlertsAssigned    CareAlert[]          @relation("CareAlertAssignee")
  pastoralNotes         PastoralNote[]       @relation("PastoralNoteAuthor")
  documentsUploaded     Document[]           @relation("DocUploadedBy")
  consentsRecorded      GuardianConsent[]    @relation("ConsentRecordedBy")
  transfersAssigned     MembershipTransfer[] @relation("TransferClerk")
  auditLogs             AuditLog[]

  // ----- Phase 1 keystone -----
  roles              UserRole[]        @relation("UserRoles")
  rolesAssigned      UserRole[]        @relation("UserRoleAssignedBy")
  notifications      Notification[]    @relation("UserNotifications")
  workItemsRequested WorkItem[]        @relation("WorkItemRequester")
  workItemsAssigned  WorkItem[]        @relation("WorkItemAssignee")
  workItemNotes      WorkItemNote[]    @relation("WorkItemNoteAuthor")
  workItemEvents     WorkItemEvent[]   @relation("WorkItemEventActor")
  workItemMessages   WorkItemMessage[] @relation("WorkItemMessageAuthor")

  // ----- Phase 2 -----
  accountRequestsReviewed AccountRequest[] @relation("AccountRequestReviewer")

  @@index([ministryId])
}

model Invite {
  id              String       @id @default(cuid())
  emailNormalized String
  tokenDigest     String       @unique // sha-256 of random token; raw token never stored
  intendedRole    Role
  ministryId      String?
  invitedById     String
  invitedBy       User         @relation("InviteInvitedBy", fields: [invitedById], references: [id])
  status          InviteStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())

  @@index([emailNormalized])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenDigest String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// ===== Directory =====
model Ministry {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  description       String?
  leaderId          String?            @unique
  leader            User?              @relation("MinistryLeader", fields: [leaderId], references: [id])
  members           User[]             @relation("MinistryMembers")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  announcements     Announcement[]
  events            Event[]
  userRoles         UserRole[]         @relation("UserRoleMinistry")
  workItems         WorkItem[]         @relation("WorkItemMinistry")
  packetSubmissions PacketSubmission[] @relation("PacketSubmissionMinistry")
  fundraisers       Fundraiser[]       @relation("MinistryFundraisers")

  newsletterSubmissions NewsletterSubmission[] @relation("NewsletterSubmissionMinistry")
}

model Household {
  id               String       @id @default(cuid())
  familyName       String?
  addressLine1     String?
  city             String?
  state            String?
  zip              String?
  anniversary      DateTime? // wedding anniversary (family-level)
  phone            String? // primary household phone
  email            String? // primary household email
  /// Member id designated as the household's primary contact (plain reference,
  /// resolved in queries; not a FK relation to keep the Household↔Member link simple).
  primaryContactId String?
  notes            String?
  /// App-level household deactivation (reversible). Distinct from deletion; when set, the
  /// household and its members are treated as inactive and member logins are disabled.
  deactivatedAt    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  members          Member[]
  fundraisers      Fundraiser[] @relation("HouseholdFundraisers")
}

model Member {
  id               String           @id @default(cuid())
  firstName        String
  lastName         String
  email            String?          @unique
  emailNormalized  String?          @unique
  phone            String?
  isMinor          Boolean          @default(false)
  dateOfBirth      DateTime? // minors: store year/age band only per policy
  baptismDate      DateTime?
  membershipStatus MembershipStatus @default(ACTIVE) // mirrors eAdventist — NOT the official record (§2A)
  joinedBy         JoinPathway? // BAPTISM | PROFESSION_OF_FAITH | TRANSFER
  directoryVisible Boolean          @default(false)
  showAddress      Boolean          @default(false)
  lastAttendance   DateTime?
  /// App-level member deactivation (reversible), independent of membershipStatus (the
  /// eAdventist mirror) and of hard deletion. When set, the member is treated as inactive
  /// and any linked login is disabled.
  deactivatedAt    DateTime?

  // ----- Individual profile detail (from the Member Information Form) -----
  baptismYear       Int? // year baptized (form captures a year, not a full date)
  joinedYear        Int? // year joined McKinney SDA
  currentMinistries String? // ministries/roles currently serving in
  ministryInterests String? // ministries/activities they'd like to join
  occupation        String? // employment (all optional)
  employer          String?
  employmentStatus  String? // EMPLOYED | SELF_EMPLOYED | RETIRED | STUDENT | UNEMPLOYED
  skills            String? // professional skills/services offered voluntarily

  /// Household-level "manage fundraising" permission (§10): may create, authorize, and edit
  /// the household's family fundraiser. Other household members can view and share it only.
  /// The household's designated primary contact is treated as holding this implicitly.
  canManageHouseholdFundraising Boolean @default(false)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])
  userId      String?    @unique
  user        User?      @relation("MemberUser", fields: [userId], references: [id])

  guardianMemberId String?
  guardian         Member?  @relation("MinorGuardian", fields: [guardianMemberId], references: [id])
  dependents       Member[] @relation("MinorGuardian")

  guardianConsents     GuardianConsent[]    @relation("ConsentMinor")
  consentsGiven        GuardianConsent[]    @relation("ConsentGuardian")
  pastoralNotes        PastoralNote[]       @relation("PastoralNoteMember")
  attendance           Attendance[]
  careAlerts           CareAlert[]          @relation("CareAlertMember")
  transfers            MembershipTransfer[] @relation("MemberTransfers")
  screening            VolunteerScreening?  @relation("MemberScreening")
  accountRequests      AccountRequest[]     @relation("AccountRequestMatch")
  mediaConsents        MediaConsent[]       @relation("MemberMediaConsent")
  offices              ChurchOffice[]       @relation("OfficerMember")
  fundraisers          Fundraiser[]         @relation("MemberFundraisers")
  committeeMemberships CommitteeMember[]    @relation("CommitteeMemberMember")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([guardianMemberId])
}

model GuardianConsent {
  id               String        @id @default(cuid())
  minorMemberId    String
  minor            Member        @relation("ConsentMinor", fields: [minorMemberId], references: [id])
  guardianMemberId String?
  guardian         Member?       @relation("ConsentGuardian", fields: [guardianMemberId], references: [id])
  guardianName     String? // when guardian is not a member record
  status           ConsentStatus @default(GRANTED)
  scope            String // e.g. "store-contact:yes; directory:no; email:no"
  noticeVersion    String
  method           String // guardian-portal | in-person | paper-form | staff-entered
  recorderRole     Role // who entered it — normally the guardian (MEMBER)
  recordedById     String // authenticated user who created the record
  recordedBy       User          @relation("ConsentRecordedBy", fields: [recordedById], references: [id])
  consentedAt      DateTime
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([minorMemberId])
}

// ===== Content =====
model Announcement {
  id           String            @id @default(cuid())
  title        String
  contentHtml  String // sanitized before store & render
  status       ApprovalStatus    @default(PENDING)
  version      Int               @default(0) // optimistic concurrency
  visibility   ContentVisibility @default(PUBLIC)
  ministryId   String
  ministry     Ministry          @relation(fields: [ministryId], references: [id])
  createdById  String
  createdBy    User              @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
  reviewedById String?
  reviewedBy   User?             @relation("AnnouncementReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectReason String?
  publishAt    DateTime?
  isFeatured   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, publishAt])
  @@index([ministryId])
}

model Event {
  id              String         @id @default(cuid())
  title           String
  slug            String?        @unique // stable public deep link: /calendar/events/[slug]
  summary         String? // short plain-text description (public teaser)
  descriptionHtml String? // full description (sanitized before store & render)
  category        EventCategory? // semantic category; falls back to ministry mapping when null
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean        @default(false)
  timezone        String         @default("America/Chicago")

  // ----- Location (fields revealed by locationType) -----
  locationType         LocationType @default(CHURCH)
  location             String? // legacy/derived one-line label (kept for back-compat display)
  venueName            String?
  addressLine1         String?
  city                 String?
  state                String?
  zip                  String?
  onlineUrl            String?
  locationInstructions String?

  // ----- Public contact -----
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  contactPublic Boolean @default(false) // whether the contact block is shown publicly

  // ----- Registration / information -----
  registrationRequired Boolean   @default(false)
  registrationUrl      String?
  infoUrl              String?
  ctaLabel             String?
  registrationDeadline DateTime?
  capacity             Int?

  // ----- Media -----
  imageUrl String?
  imageAlt String?

  // ----- Board approval (submitted for admin verification; never self-authorizes publication) -----
  boardApprovalRequired Boolean             @default(false)
  boardApprovalState    BoardApprovalState?
  boardApprovalDate     DateTime?
  boardApprovalRef      String? // e.g. minute/motion reference
  boardNoteInternal     String? // PRIVATE — never exposed publicly

  // ----- Governed lifecycle -----
  status          EventStatus       @default(DRAFT)
  version         Int               @default(0) // optimistic concurrency
  visibility      ContentVisibility @default(PUBLIC)
  submittedAt     DateTime?
  publishedAt     DateTime?
  cancelledAt     DateTime?
  submissionCount Int               @default(0)
  adminFeedback   String? // last "changes requested" comment surfaced to the department head

  ministryId   String
  ministry     Ministry      @relation(fields: [ministryId], references: [id])
  createdById  String
  createdBy    User          @relation("EventCreatedBy", fields: [createdById], references: [id])
  reviewedById String?
  reviewedBy   User?         @relation("EventReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectReason String?
  isFeatured   Boolean       @default(false)
  reviews      EventReview[] @relation("EventReviewEvent")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, startAt])
  @@index([ministryId, status])
  @@index([startAt])
}

// User-facing review/status history for an event (the governance timeline). This is NOT the
// security audit (AuditLog remains the single audit architecture) — it is the domain thread of
// review actions and comments, analogous to WorkItemEvent for tickets.
model EventReview {
  id         String       @id @default(cuid())
  eventId    String
  event      Event        @relation("EventReviewEvent", fields: [eventId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User         @relation("EventReviewActor", fields: [actorId], references: [id])
  action     String // submit | resubmit | start_review | request_changes | approve | reject | publish | unpublish | cancel | reassign | edit
  fromStatus EventStatus?
  toStatus   EventStatus?
  comment    String? // admin comment / changes-requested text (never sensitive PII)
  createdAt  DateTime     @default(now())

  @@index([eventId, createdAt])
}

model Sermon {
  id         String   @id @default(cuid())
  title      String
  speaker    String?
  preachedAt DateTime
  videoUrl   String
  notesUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([preachedAt])
}

// ===== Sensitive: prayer & pastoral (isolated + encrypted) =====
model PrayerRequest {
  id               String         @id @default(cuid())
  submitterName    String?
  submitterEmail   String?
  isAnonymous      Boolean        @default(false)
  contentEncrypted String // app-layer encryption
  wantsPublish     Boolean        @default(false)
  status           ApprovalStatus @default(PENDING)
  reviewedById     String?
  reviewedBy       User?          @relation("PrayerReviewedBy", fields: [reviewedById], references: [id])
  retainUntil      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
}

model PastoralNote {
  id               String   @id @default(cuid())
  memberId         String
  member           Member   @relation("PastoralNoteMember", fields: [memberId], references: [id])
  authorId         String
  author           User     @relation("PastoralNoteAuthor", fields: [authorId], references: [id])
  contentEncrypted String
  createdAt        DateTime @default(now())

  @@index([memberId])
}

// ===== Construction =====
model ConstructionProject {
  id                  String                     @id @default(cuid())
  title               String
  description         String?
  totalGoal           Int
  currentRaised       Int
  heroImageUrl        String?
  targetCompletion    DateTime?
  publicPledgeEnabled Boolean                    @default(true)
  active              Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  timelineItems       ConstructionTimelineItem[]
  updates             ConstructionUpdate[]
  documents           Document[]                 @relation("ProjectDocuments")
  phases              ConstructionPhase[]        @relation("ProjectPhases")
  pledges             BuildingPledge[]           @relation("ProjectPledges")
  givingLevels        GivingLevel[]              @relation("ProjectLevels")
  faqs                ProjectFaq[]               @relation("ProjectFaqs")
  photos              ProjectPhoto[]             @relation("ProjectPhotos")
}

enum PhaseStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum PledgeStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum PledgeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUAL
}

model ConstructionPhase {
  id          String              @id @default(cuid())
  projectId   String
  project     ConstructionProject @relation("ProjectPhases", fields: [projectId], references: [id])
  name        String
  description String?
  budget      Int                 @default(0)
  spent       Int                 @default(0)
  status      PhaseStatus         @default(PLANNED)
  startDate   DateTime?
  targetDate  DateTime?
  sortOrder   Int                 @default(0)

  @@index([projectId])
}

model BuildingPledge {
  id                String              @id @default(cuid())
  projectId         String
  project           ConstructionProject @relation("ProjectPledges", fields: [projectId], references: [id])
  donorName         String
  email             String?
  phone             String?
  amount            Int // total committed (whole dollars) — commitment only, no funds processed
  receivedToDate    Int                 @default(0)
  frequency         PledgeFrequency     @default(ONE_TIME)
  termMonths        Int?
  startDate         DateTime?
  status            PledgeStatus        @default(PENDING)
  isAnonymous       Boolean             @default(false)
  publicRecognition Boolean             @default(false)
  note              String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([projectId, status])
}

model GivingLevel {
  id          String              @id @default(cuid())
  projectId   String
  project     ConstructionProject @relation("ProjectLevels", fields: [projectId], references: [id])
  name        String
  minAmount   Int
  description String?
  sortOrder   Int                 @default(0)

  @@index([projectId])
}

model ProjectFaq {
  id        String              @id @default(cuid())
  projectId String
  project   ConstructionProject @relation("ProjectFaqs", fields: [projectId], references: [id])
  question  String
  answer    String
  sortOrder Int                 @default(0)

  @@index([projectId])
}

model ProjectPhoto {
  id        String              @id @default(cuid())
  projectId String
  project   ConstructionProject @relation("ProjectPhotos", fields: [projectId], references: [id])
  url       String // public URL (or a blob object key resolved to a URL)
  caption   String?
  category  String              @default("progress") // rendering | progress | completed
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())

  @@index([projectId])
}

model ConstructionTimelineItem {
  id          String              @id @default(cuid())
  projectId   String
  project     ConstructionProject @relation(fields: [projectId], references: [id])
  title       String
  description String?
  targetDate  DateTime?
  status      String // planned | in_progress | completed
  sortOrder   Int                 @default(0)
}

model ConstructionUpdate {
  id          String              @id @default(cuid())
  projectId   String
  project     ConstructionProject @relation(fields: [projectId], references: [id])
  month       Int
  year        Int
  title       String?
  description String
  photoKeys   String[]            @default([]) // object keys, not URLs
  videoUrl    String?
  createdAt   DateTime            @default(now())

  @@index([projectId, year, month])
}

// ===== Files =====
model Document {
  id                  String               @id @default(cuid())
  title               String
  provider            String // s3 | vercel-blob
  bucket              String?
  objectKey           String // NOT a URL; sign at download after authorization
  filename            String
  mimeType            String
  sizeBytes           Int
  checksumSha256      String
  visibility          DocumentVisibility   @default(PUBLIC)
  scanStatus          ScanStatus           @default(PENDING)
  uploadedById        String
  uploadedBy          User                 @relation("DocUploadedBy", fields: [uploadedById], references: [id])
  projectId           String?
  project             ConstructionProject? @relation("ProjectDocuments", fields: [projectId], references: [id])
  createdAt           DateTime             @default(now())
  workItemAttachments WorkItemAttachment[] @relation("WorkItemAttachmentDocument")

  @@index([visibility])
}

// ===== Email: identity, consent, suppression, lifecycle =====
model EmailIdentity {
  id              String              @id @default(cuid())
  emailNormalized String              @unique
  createdAt       DateTime            @default(now())
  subscriptions   EmailSubscription[]
  suppressions    Suppression[]
  messages        EmailMessage[]
}

model EmailSubscription {
  id             String             @id @default(cuid())
  identityId     String
  identity       EmailIdentity      @relation(fields: [identityId], references: [id])
  type           String // VISITOR_UPDATES | BUILDING_PROJECT | NEWSLETTER
  status         SubscriptionStatus @default(SUBSCRIBED)
  source         String?
  consentAt      DateTime? // when opt-in consent was captured
  policyVersion  String?
  subscribedAt   DateTime           @default(now())
  unsubscribedAt DateTime?

  @@unique([identityId, type])
}

// ===== Visitors =====
// A first-time/returning guest captured via the public "Connect with us" form.
// Not a Member and not a login; the clerk converts to a Member separately.
model Visitor {
  id             String        @id @default(cuid())
  name           String
  email          String
  phone          String?
  address        String?
  status         VisitorStatus @default(ACTIVE)
  marketingOptIn Boolean       @default(false)
  optInSource    String?
  optInAt        DateTime?
  firstVisitDate DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([email])
}

model Suppression {
  id         String            @id @default(cuid())
  identityId String
  identity   EmailIdentity     @relation(fields: [identityId], references: [id])
  scope      SuppressionScope
  reason     SuppressionReason
  createdAt  DateTime          @default(now())

  @@unique([identityId, scope])
}

model EmailCampaign {
  id               String         @id @default(cuid())
  subject          String
  type             EmailType      @default(MARKETING)
  audience         String
  audienceSnapshot Json? // frozen recipient identities at approval
  fromIdentity     String
  replyTo          String?
  status           String         @default("DRAFT") // DRAFT|APPROVED|SCHEDULED|SENDING|SENT|FAILED
  idempotencyKey   String         @unique
  bodyHtml         String
  createdById      String
  createdBy        User           @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  scheduledAt      DateTime?
  sentAt           DateTime?
  createdAt        DateTime       @default(now())
  messages         EmailMessage[]
}

model EmailMessage {
  id                String         @id @default(cuid())
  identityId        String
  identity          EmailIdentity  @relation(fields: [identityId], references: [id])
  campaignId        String?
  campaign          EmailCampaign? @relation(fields: [campaignId], references: [id])
  type              EmailType
  providerMessageId String?        @unique
  status            EmailStatus    @default(QUEUED)
  attempts          Int            @default(0)
  lastEventAt       DateTime?
  createdAt         DateTime       @default(now())
  events            EmailEvent[]

  @@index([campaignId])
}

model EmailEvent {
  id              String       @id @default(cuid())
  messageId       String
  message         EmailMessage @relation(fields: [messageId], references: [id])
  providerEventId String       @unique // idempotent webhook ingestion
  status          EmailStatus
  payload         Json?
  occurredAt      DateTime
  createdAt       DateTime     @default(now())
}

// ===== Automation =====
model ScheduledJobRun {
  id              String    @id @default(cuid())
  jobName         String
  scheduledPeriod String // deterministic period key, e.g. "2026-W32"
  idempotencyKey  String    @unique // jobName + scheduledPeriod
  status          JobStatus @default(RUNNING)
  leaseExpiresAt  DateTime
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  attempts        Int       @default(1)
  processedCount  Int       @default(0)
  failedCount     Int       @default(0)
  errorSummary    String?
}

model CareAlert {
  id               String          @id @default(cuid())
  memberId         String
  member           Member          @relation("CareAlertMember", fields: [memberId], references: [id])
  reason           String
  attendanceCutoff DateTime
  dedupeKey        String          @unique // memberId + cutoff window
  status           CareAlertStatus @default(OPEN)
  assignedToId     String?
  assignedTo       User?           @relation("CareAlertAssignee", fields: [assignedToId], references: [id])
  createdAt        DateTime        @default(now())
  resolvedAt       DateTime?

  @@index([status])
}

model Attendance {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  attendedAt  DateTime
  serviceName String?

  @@index([attendedAt])
}

// ===== Membership pathway/status, transfers & reference library =====
// mirrors eAdventist (§2A)
enum MembershipStatus {
