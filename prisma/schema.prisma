// ===== Sabbath School (§14E) =====
enum SSDivision {
  ADULT
  YOUTH
  EARLITEEN
  JUNIOR
  PRIMARY
  KINDERGARTEN
  BEGINNER
}

model SabbathSchoolClass {
  id                     String     @id @default(cuid())
  division               SSDivision
  name                   String
  room                   String?
  description            String?
  superintendentMemberId String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

model SabbathSchoolLesson {
  id         String   @id @default(cuid())
  quarter    String // e.g. "2026-Q3"
  weekOf     DateTime
  title      String
  guideUrl   String // official lesson source
  memoryText String?
  createdAt  DateTime @default(now())

  @@index([weekOf])
}

// ===== Weekly bulletin / order of service (§14F) =====
/// The Sabbath bulletin — the order-of-service PLUS the worship/duty metadata that renders
/// across every channel (online page, print/PDF, member email). It is the packet's linked
/// component (WeeklyPacket.bulletinId, relation "PacketBulletin"), never a competing system.
/// Approved PacketSubmission announcements are joined at render time; nothing is copied per
/// channel (single source of truth, §21). `slug` gives the permanent edition a stable route.
model Bulletin {
  id          String         @id @default(cuid())
  sabbathDate DateTime       @unique
  slug        String?        @unique // permanent-edition slug, defaults to YYYY-MM-DD
  title       String? // optional sermon-series / theme heading
  status      ApprovalStatus @default(PENDING)
  publishedAt DateTime?

  // ----- Worship / program metadata (rendered on the order-of-service side) -----
  welcomeMessage      String?
  theme               String? // sermon series / weekly theme
  sabbathSchoolLesson String?
  sabbathSchoolTime   String?
  divineWorshipTime   String?
  healthNugget        String?
  sermonTitle         String?
  speaker             String?
  scripture           String?
  offeringToday       String? // this week's tithes & offering designation
  // ----- Duty roster / footer facts -----
  elderOnDuty         String?
  nurseOnDuty         String?
  sundownTonight      String? // Friday sundown, e.g. "8:14 PM"
  sundownNext         String? // next Friday sundown
  nextSabbathSpeaker  String?
  nextSabbathOffering String?
  heroImageUrl        String?
  inspiration         String? // weekly back-cover devotional quote
  inspirationSource   String? // its attribution/source

  // ----- Print/PDF artifact (immutable per publish; versioned on republish, §17) -----
  pdfDocumentId  String? // signed-download Document when a binary artifact is attached
  pdfVersion     Int       @default(0)
  pdfGeneratedAt DateTime?

  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  items         OrderOfServiceItem[]
  distributions BulletinDistribution[]
  weeklyPacket  WeeklyPacket?          @relation("PacketBulletin")
}

model OrderOfServiceItem {
  id          String   @id @default(cuid())
  bulletinId  String
  bulletin    Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0)
  title       String // "Opening Hymn", "Sermon", "Offering", ...
  detail      String? // hymn number, sermon title
  participant String?

  @@index([bulletinId, sortOrder])
}

// ===== Officers, board & minutes (§14G) =====
enum OfficerRole {
  ELDER
  DEACON
  DEACONESS
  CLERK
  TREASURER
  SS_SUPERINTENDENT
  MINISTRY_LEADER
  OTHER
}

enum MeetingType {
  BOARD
  BUSINESS
}

model ChurchOffice {
  id         String      @id @default(cuid())
  role       OfficerRole
  title      String
  memberId   String
  member     Member      @relation("OfficerMember", fields: [memberId], references: [id])
  ministryId String?
  termStart  DateTime
  termEnd    DateTime?
  electedAt  DateTime?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())

  @@index([role, active])
}

model BoardMeeting {
  id               String         @id @default(cuid())
  type             MeetingType
  meetingDate      DateTime
  location         String?
  agendaHtml       String?
  attendees        String? // freeform attendee list
  excusedAbsences  String?
  minutesEncrypted String? // sensitive; access-restricted + app-layer encrypted
  status           ApprovalStatus @default(PENDING) // draft -> approved minutes
  approvedAt       DateTime?
  committeeId      String?
  committee        Committee?     @relation("CommitteeMeetings", fields: [committeeId], references: [id])
