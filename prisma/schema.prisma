// ===== Config & audit =====
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  requestId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ===== Peer-to-peer fundraising =====
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum DonationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// PLEDGE = commitment; GIVEN = reported as given via AdventistGiving (no card data here)
enum DonationKind {
  PLEDGE
  GIVEN
}

model FundraisingCampaign {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  title                  String
  description            String?
  goal                   Int            @default(0)
  status                 CampaignStatus @default(ACTIVE)
  constructionProjectId  String? // optional link to the building project
  coverImageUrl          String?
  allowMemberFundraisers Boolean        @default(true)
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  fundraisers            Fundraiser[]
  donations              Donation[]

  @@index([status])
}

model Fundraiser {
  id           String              @id @default(cuid())
  campaignId   String
  campaign     FundraisingCampaign @relation(fields: [campaignId], references: [id])
  memberId     String?
  member       Member?             @relation("MemberFundraisers", fields: [memberId], references: [id])
  ownerUserId  String?
  slug         String              @unique
  displayName  String
  title        String
  story        String?
  personalGoal Int                 @default(0)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  donations    Donation[]

  @@index([campaignId])
}

model Donation {
  id           String              @id @default(cuid())
  campaignId   String
  campaign     FundraisingCampaign @relation(fields: [campaignId], references: [id])
  fundraiserId String?
  fundraiser   Fundraiser?         @relation(fields: [fundraiserId], references: [id])
  donorName    String
  email        String?
  amount       Int
  kind         DonationKind        @default(PLEDGE)
  status       DonationStatus      @default(PENDING)
  isAnonymous  Boolean             @default(false)
  message      String?
  createdAt    DateTime            @default(now())
  confirmedAt  DateTime?

  @@index([campaignId, status])
  @@index([fundraiserId, status])
}

// ===== Phase 1 keystone: multi-role RBAC, WorkItem spine, notifications =====

/// Authoritative source of truth for authorization. A user may hold several roles at once
/// (e.g. MEMBER + ELDER + MINISTRY_HEAD). MINISTRY_HEAD assignments are scoped to a ministry.
/// Global (ministry-agnostic) roles have ministryId = null. Uniqueness of ACTIVE assignments
/// is enforced by two partial unique indexes created in the migration (Prisma @@unique cannot
/// express the `WHERE active` predicate): one for global roles, one for ministry-scoped roles.
model UserRole {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         Role
  ministryId   String?
  ministry     Ministry? @relation("UserRoleMinistry", fields: [ministryId], references: [id])
  active       Boolean   @default(true)
  assignedById String?
  assignedBy   User?     @relation("UserRoleAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, active])
  @@index([role, active])
  @@index([ministryId])
}

enum WorkItemType {
  CARE
  PRAYER
  LEADERSHIP_MESSAGE
  SUPPORT
  VOLUNTEER
  SPONSOR
  CONTACT
}

enum WorkItemStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  FOLLOW_UP
  NEEDS_INFO
  RESOLVED
  CLOSED
}

enum WorkItemPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkItemConfidentiality {
  NORMAL
  SENSITIVE
  LEADERSHIP_ONLY
}

enum WorkItemMessageDirection {
  INBOUND
  OUTBOUND
}

/// The shared communication spine. Every request-with-a-lifecycle (care, prayer, contact,
/// leadership message, support, volunteer, sponsor) is a WorkItem so routing, assignment,
/// notes, messaging, notifications and history are implemented once. Sensitive detail is
/// stored in bodyEncrypted (AES-256-GCM), never in plaintext columns.
model WorkItem {
  id              String                  @id @default(cuid())
  type            WorkItemType
  status          WorkItemStatus          @default(NEW)
  priority        WorkItemPriority        @default(NORMAL)
  confidentiality WorkItemConfidentiality @default(NORMAL)
  title           String
  category        String?
  bodyEncrypted   String?
  requesterUserId String?
  requesterUser   User?                   @relation("WorkItemRequester", fields: [requesterUserId], references: [id])
  requesterName   String?
  requesterEmail  String?
  subjectName     String?
  assigneeUserId  String?
  assignee        User?                   @relation("WorkItemAssignee", fields: [assigneeUserId], references: [id])
  ministryId      String?
  ministry        Ministry?               @relation("WorkItemMinistry", fields: [ministryId], references: [id])
  closeReason     String?
  followUpAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  closedAt        DateTime?
  notes           WorkItemNote[]
  events          WorkItemEvent[]
  messages        WorkItemMessage[]
  attachments     WorkItemAttachment[]

  @@index([type, status])
  @@index([assigneeUserId, status])
  @@index([ministryId, status])
  @@index([status, priority])
}

/// Internal, staff-only note. Encrypted at rest for sensitive/leadership items.
model WorkItemNote {
  id            String   @id @default(cuid())
  workItemId    String
  workItem      WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorUserId  String?
  author        User?    @relation("WorkItemNoteAuthor", fields: [authorUserId], references: [id])
  bodyEncrypted String
  createdAt     DateTime @default(now())

  @@index([workItemId])
}

/// Immutable lifecycle history (append-only). One row per state change / significant action.
model WorkItemEvent {
  id          String          @id @default(cuid())
  workItemId  String
  workItem    WorkItem        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?           @relation("WorkItemEventActor", fields: [actorUserId], references: [id])
  kind        String // CREATED | STATUS_CHANGE | ASSIGNED | NOTE_ADDED | MESSAGE | ...
  fromStatus  WorkItemStatus?
  toStatus    WorkItemStatus?
  detail      String?
  createdAt   DateTime        @default(now())

  @@index([workItemId, createdAt])
}

/// Requester <-> authorized-staff thread. Body is not encrypted (it is shared with the requester).
model WorkItemMessage {
  id           String                   @id @default(cuid())
  workItemId   String
  workItem     WorkItem                 @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  direction    WorkItemMessageDirection
  authorUserId String?
  author       User?                    @relation("WorkItemMessageAuthor", fields: [authorUserId], references: [id])
  body         String
  createdAt    DateTime                 @default(now())

  @@index([workItemId, createdAt])
}

/// Attachment binding to a secured Document (authorization + signed download handled by Document).
model WorkItemAttachment {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation("WorkItemAttachmentDocument", fields: [documentId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([workItemId, documentId])
  @@index([workItemId])
}

/// Shared in-app notification. One architecture for every module; delivered to the bell UI.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  category   String
  title      String
  body       String?
  deepLink   String?
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ===== Phase 2: member account requests + membership matching (§20) =====

enum AccountRequestStatus {
  AUTO_APPROVED // unique high-confidence match -> account created automatically
  PENDING_ADMIN_REVIEW // ambiguous / no confident match -> admin exception queue
  APPROVED // admin approved -> account created
  REJECTED
  NEEDS_INFO
}

/// A public "Request a Member Account" submission (§20). Distinct from User: no account
/// exists until the request is approved (auto or by an admin), at which point a User is
/// created + bound to the matched Member. The password is captured at request time and stored
/// hashed here, then transferred to the User on approval (never a plaintext password at rest).
model AccountRequest {
  id               String               @id @default(cuid())
  firstName        String
  lastName         String
  email            String
  emailNormalized  String
  phone            String?
  /// Free-form verification aid the requester supplies (e.g. year joined). Non-sensitive.
  verificationData String?
  passwordHash     String // bcrypt; moved to the User on approval, deleted on reject
  status           AccountRequestStatus @default(PENDING_ADMIN_REVIEW)
  matchedMemberId  String?
  matchedMember    Member?              @relation("AccountRequestMatch", fields: [matchedMemberId], references: [id])
  matchConfidence  Int? // 0..100 from the pure matcher
  matchBand        String? // EXACT | HIGH | MEDIUM | LOW | NONE
  reviewedById     String?
  reviewedBy       User?                @relation("AccountRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  reviewNote       String?
  createdUserId    String? // the User created on approval (audit trail)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([emailNormalized])
}

// ===== Phase 3: Weekly Communications engine (§22/§23) =====

enum WeeklyPacketStatus {
  COLLECTING
  IN_REVIEW
  READY
  PUBLISHED
  ARCHIVED
}

enum PacketSubmissionKind {
  ANNOUNCEMENT
  EVENT
  SABBATH_PROGRAM_ITEM
  PARTICIPANT
  MINISTRY_UPDATE
  NOTHING_THIS_WEEK
}

enum PacketSubmissionStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  NEEDS_INFO
}

/// One weekly communications packet per Sabbath. Aggregates ministry submissions and links the
/// existing Bulletin as its order-of-service component (§23). Readiness is a pure calculation
/// persisted here for display; version guards concurrent review/publish.
model WeeklyPacket {
  id             String             @id @default(cuid())
  sabbathDate    DateTime           @unique
  status         WeeklyPacketStatus @default(COLLECTING)
  readinessScore Int                @default(0)
  deadlineAt     DateTime?
  publishedAt    DateTime?
  version        Int                @default(0)
  bulletinId     String?            @unique
  bulletin       Bulletin?          @relation("PacketBulletin", fields: [bulletinId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  submissions    PacketSubmission[]

  @@index([status, sabbathDate])
}

/// A single contribution to a weekly packet from a ministry (announcement, event, Sabbath program
/// item, participant, ministry update, or an explicit "nothing this week"). Submitter/reviewer are
/// stored as scalar ids for audit/display (no FK, matching the AccountRequest pattern).
model PacketSubmission {
  id              String                 @id @default(cuid())
  packetId        String
  packet          WeeklyPacket           @relation(fields: [packetId], references: [id], onDelete: Cascade)
  ministryId      String?
  ministry        Ministry?              @relation("PacketSubmissionMinistry", fields: [ministryId], references: [id])
  submittedById   String?
  kind            PacketSubmissionKind
  status          PacketSubmissionStatus @default(SUBMITTED)
  title           String?
  body            String?
  participantName String?
  reviewNote      String?
  reviewedById    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([packetId, status])
  @@index([ministryId])
  @@index([submittedById])
}

// ===== Phase 7: Email template administration (§38/§39) =====

/// Admin-overridable email template. When an active row exists for a `key`, it overrides the
/// code default from lib/email-registry. Bodies are safe {{variable}} templates — NEVER code.
model EmailTemplate {
  id          String                 @id @default(cuid())
  key         String                 @unique
  subject     String
  htmlBody    String
  textBody    String?
  category    String
  channel     EmailType              @default(TRANSACTIONAL)
  active      Boolean                @default(true)
  updatedById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  versions    EmailTemplateVersion[]
}

/// Immutable prior versions of a template (edit history, §39).
model EmailTemplateVersion {
  id          String        @id @default(cuid())
  templateId  String
  template    EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  subject     String
  htmlBody    String
  textBody    String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@index([templateId, createdAt])
}

// ===== Phase 9: lightweight CMS (§44) =====

/// Admin-managed content for public surfaces (hero, banners, About, etc.). Public pages read the
/// block and fall back to safe coded defaults when absent. Rich HTML is sanitized on write.
model ContentBlock {
  id          String   @id @default(cuid())
  key         String
  locale      String   @default("en")
  content     String
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, locale])
  @@index([key])
}
