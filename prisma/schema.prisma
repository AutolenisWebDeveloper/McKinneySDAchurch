// ===== Phase 6: Governance — committees, motions, action items, secretary notes, Church Manual (§31–§35) =====

enum MotionResult {
  PENDING
  CARRIED
  FAILED
  TABLED
  WITHDRAWN
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// A committee (governance body). Archived rather than deleted so history is preserved (§32).
model Committee {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     CommitteeMember[]
  meetings    BoardMeeting[]    @relation("CommitteeMeetings")
  actionItems ActionItem[]      @relation("CommitteeActionItems")
  notes       SecretaryNote[]   @relation("CommitteeNotes")
}

model CommitteeMember {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member    @relation("CommitteeMemberMember", fields: [memberId], references: [id])
  role        String? // Chair | Secretary | Member
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([committeeId, memberId])
  @@index([committeeId])
}

/// A motion at a board/business/committee meeting. Aggregate vote counts serve as the vote record.
model Motion {
  id           String       @id @default(cuid())
  meetingId    String
  meeting      BoardMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  text         String
  moverName    String?
  seconderName String?
  result       MotionResult @default(PENDING)
  votesFor     Int          @default(0)
  votesAgainst Int          @default(0)
  votesAbstain Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([meetingId])
}

/// A tracked action item arising from a meeting or committee. Owner is a scalar id/name.
model ActionItem {
  id            String           @id @default(cuid())
  description   String
  ownerMemberId String?
  ownerName     String?
  dueDate       DateTime?
  status        ActionItemStatus @default(OPEN)
  meetingId     String?
  meeting       BoardMeeting?    @relation("MeetingActionItems", fields: [meetingId], references: [id])
  committeeId   String?
  committee     Committee?       @relation("CommitteeActionItems", fields: [committeeId], references: [id])
  createdById   String?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([meetingId])
  @@index([committeeId])
}

/// Internal secretary/governance note, encrypted at rest. Optionally linked to a meeting or committee.
model SecretaryNote {
  id            String        @id @default(cuid())
  bodyEncrypted String
  authorId      String?
  confidential  Boolean       @default(true)
  meetingId     String?
  meeting       BoardMeeting? @relation("MeetingNotes", fields: [meetingId], references: [id])
  committeeId   String?
  committee     Committee?    @relation("CommitteeNotes", fields: [committeeId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([meetingId])
  @@index([committeeId])
}

/// A version of the SDA Church Manual. Content is an uploaded/authorized PDF or an official link —
/// NEVER scraped copyrighted text (§35). Exactly one active version is the current one.
model ChurchManualVersion {
  id            String    @id @default(cuid())
  version       String // e.g. "19th ed. (2022)"
  title         String?
  documentId    String? // uploaded Document (PDF) — scalar link
  externalUrl   String? // or an official link
  effectiveDate DateTime?
  releaseNotes  String?
  active        Boolean   @default(false)
  uploadedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
}

// ===== Ordinances & membership pathways (§14H) =====
enum BaptismStatus {
  REQUESTED
  IN_CLASS
  SCHEDULED
  COMPLETED
  WITHDRAWN
}

model BaptismCandidate {
  id               String        @id @default(cuid())
  personName       String
  memberId         String?
  contactEmail     String?
  contactPhone     String?
  status           BaptismStatus @default(REQUESTED)
  classCompletedAt DateTime?
  scheduledAt      DateTime?
  note             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
}

// Communion (quarterly, incl. foot-washing) and profession-of-faith are calendar Events with a type tag;
// profession of faith also sets Member.joinedBy = PROFESSION_OF_FAITH.

// ===== Giving structure (giving itself stays external — AdventistGiving) (§14I) =====
model OfferingCalendarEntry {
  id                   String   @id @default(cuid())
  weekOf               DateTime
  offeringName         String
  isConferenceOffering Boolean  @default(false) // follows the denominational offering calendar
  note                 String?

  @@index([weekOf])
}

// Youth clubs (Pathfinders / Adventurers / AY) were retired: the model had no application
// surface (no route, action, query, or seed ever wrote to it) and youth-club/minor-facing
// functionality is out of scope unless separately authorized. Removing the unused
// minor-PII table is a data-minimization win. See migration
// 20260811140000_retire_youth_club_registration and docs/SAFEGUARDING_AUDIT.md.

// ===== Config & audit =====
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  requestId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ===== Peer-to-peer fundraising =====
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum DonationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// PLEDGE = commitment; GIVEN = reported as given via AdventistGiving (no card data here)
enum DonationKind {
  PLEDGE
  GIVEN
}

/// Who a fundraiser is raising on behalf of. PERSONAL is owned by one member (or Supporter),
/// FAMILY by a household, MINISTRY by a ministry/team. Eligibility to create each type is
/// decided in rbac.ts, never in the UI.
enum FundraiserType {
  PERSONAL
  FAMILY
  MINISTRY
}

/// A fundraiser's reviewed lifecycle. Transitions are guarded server-side by the pure state
/// machine in src/lib/fundraiser-workflow.ts; nothing goes public before ACTIVE. "Goal
/// reached" is a DERIVED flag (verified raised >= goal), not a status — an over-goal
/// fundraiser stays ACTIVE and keeps accepting gifts.
enum FundraiserStatus {
  DRAFT // created, not yet submitted
  PENDING_REVIEW // submitted, awaiting an admin decision
  CHANGES_REQUESTED // returned to the owner with a note
  REJECTED // declined (admin may reopen to PENDING_REVIEW)
  ACTIVE // approved; public page live and shareable
  CLOSED // ended by the owner or an admin; read-only
  ARCHIVED // retired by an admin; hidden from member surfaces, retained for records
}

/// Approved share copy and campaign graphics offered in the Share tab. Managed by admins in
/// the Building Project content library.
enum FundraisingAssetKind {
  MESSAGE
  GRAPHIC
}

model FundraisingCampaign {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  title                  String
  description            String?
  goal                   Int            @default(0)
  status                 CampaignStatus @default(ACTIVE)
  constructionProjectId  String? // optional link to the building project
  coverImageUrl          String?
  allowMemberFundraisers Boolean        @default(true)
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  fundraisers            Fundraiser[]
  donations              Donation[]

  @@index([status])
}

/// One person's / household's / ministry's fundraising page for a campaign. The fundraiser
/// belongs to an EXISTING identity — a member's User+Member, or (non-member carve-out) a
/// Supporter. There is no separate fundraiser account, login, or profile.
///
/// Verified progress is NOT stored here: it is always derived from Donation rows with
/// status = CONFIRMED, so there is exactly one source of truth for money and no denormalized
/// total can drift from the ledger.
///
/// "One live family fundraiser per household" and "one live fundraiser per ministry" are
/// enforced by partial unique indexes created in the migration (Prisma's @@unique cannot
/// express the `WHERE status IN (...)` predicate), matching the UserRole pattern.
model Fundraiser {
  id     String           @id @default(cuid())
  type   FundraiserType   @default(PERSONAL)
  status FundraiserStatus @default(DRAFT)

  campaignId String
  campaign   FundraisingCampaign @relation(fields: [campaignId], references: [id])

  // ----- Ownership. Exactly one owning identity, by type:
  // PERSONAL -> ownerUserId+memberId (member) or supporterId (non-member)
  // FAMILY   -> householdId (edited by a household member with the fundraising permission)
  // MINISTRY -> ministryId (edited by an authorized ministry/team leader)
  memberId    String?
  member      Member?    @relation("MemberFundraisers", fields: [memberId], references: [id])
  ownerUserId String?
  supporterId String?
  supporter   Supporter? @relation("SupporterFundraisers", fields: [supporterId], references: [id])
  householdId String?
  household   Household? @relation("HouseholdFundraisers", fields: [householdId], references: [id])
  ministryId  String?
  ministry    Ministry?  @relation("MinistryFundraisers", fields: [ministryId], references: [id])

  slug         String    @unique
  displayName  String
  title        String
  story        String?
  graphicUrl   String?
  personalGoal Int       @default(0)
  targetDate   DateTime?

  /// Opaque token carried by this page's "Start Your Own Fundraiser" link so a fundraiser
  /// started from it can be attributed back here (§4). Not a credential — it grants nothing.
  referralToken          String       @unique
  referredByFundraiserId String?
  referredBy             Fundraiser?  @relation("FundraiserReferrals", fields: [referredByFundraiserId], references: [id])
  referrals              Fundraiser[] @relation("FundraiserReferrals")

  /// Admin note attached to CHANGES_REQUESTED / REJECTED. Shown to the owner.
  reviewNote        String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  approvedAt        DateTime?
  closedAt          DateTime?
  /// Highest goal milestone (25/50/75/100) already notified, so each fires exactly once.
  milestoneNotified Int       @default(0)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  donations Donation[]
  handoffs  GivingHandoff[] @relation("HandoffFundraiser")

  @@index([campaignId, status])
  @@index([ownerUserId, status])
  @@index([householdId, status])
  @@index([ministryId, status])
  @@index([supporterId, status])
  @@index([referredByFundraiserId])
}

/// A visitor left for AdventistGiving through a fundraiser's giving link. This is the
/// CANDIDATE attribution signal (§4): it deliberately carries no donor identity and no
/// amount — only that a handoff happened — and never counts toward verified progress. The
/// treasurer uses it during CSV reconciliation to attribute a confirmed gift to a fundraiser.
model GivingHandoff {
  id           String     @id @default(cuid())
  fundraiserId String
  fundraiser   Fundraiser @relation("HandoffFundraiser", fields: [fundraiserId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([fundraiserId, createdAt])
}

/// A non-member who runs a fundraiser for the Building Project (§15). Deliberately NOT a
/// Member and NOT a User: a Supporter has no Member Portal access, no directory presence, no
/// household, and no ministry data. It exists only to own a fundraiser and its public page,
/// and is reached through a one-time emailed link scoped to a single fundraiser.
model Supporter {
  id              String    @id @default(cuid())
  name            String
  email           String
  emailNormalized String    @unique
  /// Recorded when the Supporter attested they are 18 or older at sign-up. A non-member's page
  /// carries their name publicly, and minors cannot self-register anywhere on this platform, so
  /// the attestation is required before a Supporter fundraiser can be created.
  adultAttestedAt DateTime?
  /// Set when an admin migrates this Supporter's fundraisers to a Member identity.
  linkedMemberId  String?
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fundraisers Fundraiser[]          @relation("SupporterFundraisers")
  loginTokens SupporterLoginToken[] @relation("SupporterTokens")
}

/// Single-use, single-fundraiser magic-link token. Only the sha-256 digest is stored, exactly
/// as Invite/PasswordResetToken do — the raw token exists only in the emailed URL.
model SupporterLoginToken {
  id           String    @id @default(cuid())
  supporterId  String
  supporter    Supporter @relation("SupporterTokens", fields: [supporterId], references: [id], onDelete: Cascade)
  /// The one fundraiser this link may manage. A Supporter never gets a combined dashboard.
  fundraiserId String
  tokenDigest  String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([supporterId])
}

/// Admin-curated share copy and campaign graphics offered to fundraiser owners in the Share
/// tab (§16). Church-approved wording only — owners pick from this list rather than the app
/// generating marketing copy for them.
model FundraisingAsset {
  id        String               @id @default(cuid())
  kind      FundraisingAssetKind
  title     String
  /// Message text (kind = MESSAGE).
  body      String?
  /// Graphic URL (kind = GRAPHIC).
  imageUrl  String?
  active    Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([kind, active, sortOrder])
}

model Donation {
  id           String              @id @default(cuid())
  campaignId   String
  campaign     FundraisingCampaign @relation(fields: [campaignId], references: [id])
  fundraiserId String?
  fundraiser   Fundraiser?         @relation(fields: [fundraiserId], references: [id])
  donorName    String
  email        String?
  amount       Int
  kind         DonationKind        @default(PLEDGE)
  status       DonationStatus      @default(PENDING)
  isAnonymous  Boolean             @default(false)
  message      String?
  createdAt    DateTime            @default(now())
  confirmedAt  DateTime?

  @@index([campaignId, status])
  @@index([fundraiserId, status])
}

// ===== Phase 1 keystone: multi-role RBAC, WorkItem spine, notifications =====

/// Authoritative source of truth for authorization. A user may hold several roles at once
/// (e.g. MEMBER + ELDER + MINISTRY_HEAD). MINISTRY_HEAD assignments are scoped to a ministry.
/// Global (ministry-agnostic) roles have ministryId = null. Uniqueness of ACTIVE assignments
/// is enforced by two partial unique indexes created in the migration (Prisma @@unique cannot
/// express the `WHERE active` predicate): one for global roles, one for ministry-scoped roles.
model UserRole {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         Role
  ministryId   String?
  ministry     Ministry? @relation("UserRoleMinistry", fields: [ministryId], references: [id])
  active       Boolean   @default(true)
  assignedById String?
  assignedBy   User?     @relation("UserRoleAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, active])
  @@index([role, active])
  @@index([ministryId])
}

enum WorkItemType {
  CARE
  PRAYER
  LEADERSHIP_MESSAGE
  SUPPORT
  VOLUNTEER
  SPONSOR
  CONTACT
}

enum WorkItemStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  FOLLOW_UP
  NEEDS_INFO
  RESOLVED
  CLOSED
}

enum WorkItemPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkItemConfidentiality {
  NORMAL
  SENSITIVE
  LEADERSHIP_ONLY
}

enum WorkItemMessageDirection {
  INBOUND
  OUTBOUND
}

/// The shared communication spine. Every request-with-a-lifecycle (care, prayer, contact,
/// leadership message, support, volunteer, sponsor) is a WorkItem so routing, assignment,
/// notes, messaging, notifications and history are implemented once. Sensitive detail is
/// stored in bodyEncrypted (AES-256-GCM), never in plaintext columns.
model WorkItem {
  id              String                  @id @default(cuid())
  type            WorkItemType
  status          WorkItemStatus          @default(NEW)
  priority        WorkItemPriority        @default(NORMAL)
  confidentiality WorkItemConfidentiality @default(NORMAL)
  title           String
  category        String?
  bodyEncrypted   String?
  requesterUserId String?
  requesterUser   User?                   @relation("WorkItemRequester", fields: [requesterUserId], references: [id])
  requesterName   String?
  requesterEmail  String?
  subjectName     String?
  assigneeUserId  String?
  assignee        User?                   @relation("WorkItemAssignee", fields: [assigneeUserId], references: [id])
  ministryId      String?
  ministry        Ministry?               @relation("WorkItemMinistry", fields: [ministryId], references: [id])
  closeReason     String?
  followUpAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  closedAt        DateTime?
  notes           WorkItemNote[]
  events          WorkItemEvent[]
  messages        WorkItemMessage[]
  attachments     WorkItemAttachment[]

  @@index([type, status])
  @@index([assigneeUserId, status])
  @@index([ministryId, status])
  @@index([status, priority])
}

/// Internal, staff-only note. Encrypted at rest for sensitive/leadership items.
model WorkItemNote {
  id            String   @id @default(cuid())
  workItemId    String
  workItem      WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorUserId  String?
  author        User?    @relation("WorkItemNoteAuthor", fields: [authorUserId], references: [id])
  bodyEncrypted String
  createdAt     DateTime @default(now())

  @@index([workItemId])
}

/// Immutable lifecycle history (append-only). One row per state change / significant action.
model WorkItemEvent {
  id          String          @id @default(cuid())
  workItemId  String
  workItem    WorkItem        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?           @relation("WorkItemEventActor", fields: [actorUserId], references: [id])
  kind        String // CREATED | STATUS_CHANGE | ASSIGNED | NOTE_ADDED | MESSAGE | ...
  fromStatus  WorkItemStatus?
  toStatus    WorkItemStatus?
  detail      String?
  createdAt   DateTime        @default(now())

  @@index([workItemId, createdAt])
}

/// Requester <-> authorized-staff thread. Body is not encrypted (it is shared with the requester).
model WorkItemMessage {
  id           String                   @id @default(cuid())
  workItemId   String
  workItem     WorkItem                 @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  direction    WorkItemMessageDirection
  authorUserId String?
  author       User?                    @relation("WorkItemMessageAuthor", fields: [authorUserId], references: [id])
  body         String
  createdAt    DateTime                 @default(now())

  @@index([workItemId, createdAt])
}

/// Attachment binding to a secured Document (authorization + signed download handled by Document).
model WorkItemAttachment {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation("WorkItemAttachmentDocument", fields: [documentId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([workItemId, documentId])
  @@index([workItemId])
}

/// Shared in-app notification. One architecture for every module; delivered to the bell UI.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  category   String
  title      String
  body       String?
  deepLink   String?
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ===== Phase 2: member account requests + membership matching (§20) =====

enum AccountRequestStatus {
  AUTO_APPROVED // unique high-confidence match -> account created automatically
  PENDING_ADMIN_REVIEW // ambiguous / no confident match -> admin exception queue
  APPROVED // admin approved -> account created
  REJECTED
  NEEDS_INFO
}

/// A public "Request a Member Account" submission (§20). Distinct from User: no account
/// exists until the request is approved (auto or by an admin), at which point a User is
/// created + bound to the matched Member. The password is captured at request time and stored
/// hashed here, then transferred to the User on approval (never a plaintext password at rest).
model AccountRequest {
  id               String               @id @default(cuid())
  firstName        String
  lastName         String
  email            String
  emailNormalized  String
  phone            String?
  /// Free-form verification aid the requester supplies (e.g. year joined). Non-sensitive.
  verificationData String?
  passwordHash     String // bcrypt; moved to the User on approval, deleted on reject
  status           AccountRequestStatus @default(PENDING_ADMIN_REVIEW)
  matchedMemberId  String?
  matchedMember    Member?              @relation("AccountRequestMatch", fields: [matchedMemberId], references: [id])
  matchConfidence  Int? // 0..100 from the pure matcher
  matchBand        String? // EXACT | HIGH | MEDIUM | LOW | NONE
  reviewedById     String?
  reviewedBy       User?                @relation("AccountRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  reviewNote       String?
  createdUserId    String? // the User created on approval (audit trail)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([emailNormalized])
}

// ===== Phase 3: Weekly Communications engine (§22/§23) =====

enum WeeklyPacketStatus {
  COLLECTING
  IN_REVIEW
  READY
  PUBLISHED
  ARCHIVED
}

enum PacketSubmissionKind {
  ANNOUNCEMENT
  EVENT
  SABBATH_PROGRAM_ITEM
  PARTICIPANT
  MINISTRY_UPDATE
  NOTHING_THIS_WEEK
}

/// Governed submission lifecycle (§6). New values extend the original set additively so
/// existing rows/migrations stay valid. Canonical flow:
///   DRAFT → SUBMITTED → UNDER_REVIEW → APPROVED | CHANGES_REQUESTED | REJECTED
///   APPROVED → PUBLISHED → ARCHIVED
/// Legacy ACCEPTED ≈ APPROVED and NEEDS_INFO ≈ CHANGES_REQUESTED are retained for back-compat
/// and normalized in the pure state layer.
enum PacketSubmissionStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  NEEDS_INFO
  DRAFT
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

/// One weekly communications packet per Sabbath. Aggregates ministry submissions and links the
/// existing Bulletin as its order-of-service component (§23). Readiness is a pure calculation
/// persisted here for display; version guards concurrent review/publish.
model WeeklyPacket {
  id             String             @id @default(cuid())
  sabbathDate    DateTime           @unique
  status         WeeklyPacketStatus @default(COLLECTING)
  readinessScore Int                @default(0)
  deadlineAt     DateTime?
  publishedAt    DateTime?
  version        Int                @default(0)
  bulletinId     String?            @unique
  bulletin       Bulletin?          @relation("PacketBulletin", fields: [bulletinId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  submissions    PacketSubmission[]
  reminders      BulletinReminder[]

  @@index([status, sabbathDate])
}

/// A single contribution to a weekly packet from a ministry (announcement, event, Sabbath program
/// item, participant, ministry update, or an explicit "nothing this week"). Submitter/reviewer are
/// stored as scalar ids for audit/display (no FK, matching the AccountRequest pattern).
model PacketSubmission {
  id              String                 @id @default(cuid())
  packetId        String
  packet          WeeklyPacket           @relation(fields: [packetId], references: [id], onDelete: Cascade)
  ministryId      String?
  ministry        Ministry?              @relation("PacketSubmissionMinistry", fields: [ministryId], references: [id])
  submittedById   String?
  kind            PacketSubmissionKind
  status          PacketSubmissionStatus @default(SUBMITTED)
  version         Int                    @default(0) // optimistic concurrency for edit/review
  title           String?
  body            String? // legacy free-text body (kept; also used as short summary fallback)
  participantName String?

  // ----- Announcement content (two layers, §4): print summary vs. extended online detail -----
  summary         String? // short, print-appropriate bulletin summary
  fullContentHtml String? // extended online-only detail (sanitized before store)
  category        String? // editorial category (This Weekend, Coming Up, Ministries, …)
  slug            String? // stable deep-link anchor within the edition (#slug)

  // ----- Event / logistics -----
  eventStartAt DateTime?
  eventEndAt   DateTime?
  location     String?
  recurring    Boolean   @default(false)
  recurrence   String? // human description when recurring

  // ----- Contact -----
  contactName  String?
  contactEmail String?
  contactPhone String?

  // ----- Links / CTA / media (URLs validated before store) -----
  registrationUrl String?
  externalUrl     String?
  ctaLabel        String?
  ctaUrl          String?
  imageUrl        String?

  // ----- Editorial controls (admin) -----
  featured          Boolean @default(false)
  includeInPrint    Boolean @default(true)
  includeOnline     Boolean @default(true)
  sortOrder         Int     @default(0) // editorial ordering within a category
  requestedPriority String? // dept-head request: LOW | NORMAL | HIGH
  internalNotes     String? // private note to Admin (never rendered publicly)

  reviewNote   String? // admin feedback shown to the department head
  reviewedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([packetId, slug])
  @@index([packetId, status])
  @@index([ministryId])
  @@index([submittedById])
}

/// Idempotency + audit ledger for the Monday/Wednesday department-head reminder crons (§11/§12).
/// One row per (packet, reminder kind, recipient) guarantees a cron re-run never double-sends.
model BulletinReminder {
  id         String       @id @default(cuid())
  packetId   String
  packet     WeeklyPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  kind       String // MONDAY | WEDNESDAY
  userId     String
  ministryId String?
  state      String? // resolved recipient state that drove a Wednesday reminder
  sentAt     DateTime     @default(now())

  @@unique([packetId, kind, userId])
  @@index([packetId, kind])
}

/// Friday 5:00 PM member-distribution ledger (§18). Unique per (bulletin, channel) so the
/// scheduled job is idempotent: a retry/duplicate run finds the existing record and no-ops.
model BulletinDistribution {
  id              String    @id @default(cuid())
  bulletinId      String
  bulletin        Bulletin  @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  channel         String // FRIDAY_EMAIL
  status          String    @default("PENDING") // PENDING | SENT | FAILED
  recipientCount  Int       @default(0)
  sentCount       Int       @default(0)
  suppressedCount Int       @default(0)
  scheduledFor    DateTime?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  error           String?

  @@unique([bulletinId, channel])
  @@index([bulletinId])
}

// ===== Phase 7: Email template administration (§38/§39) =====

/// Admin-overridable email template. When an active row exists for a `key`, it overrides the
/// code default from lib/email-registry. Bodies are safe {{variable}} templates — NEVER code.
model EmailTemplate {
  id          String                 @id @default(cuid())
  key         String                 @unique
  subject     String
  htmlBody    String
  textBody    String?
  category    String
  channel     EmailType              @default(TRANSACTIONAL)
  active      Boolean                @default(true)
  updatedById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  versions    EmailTemplateVersion[]
}

/// Immutable prior versions of a template (edit history, §39).
model EmailTemplateVersion {
  id          String        @id @default(cuid())
  templateId  String
  template    EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  subject     String
  htmlBody    String
  textBody    String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@index([templateId, createdAt])
}

// ===== Phase 9: lightweight CMS (§44) =====

/// Admin-managed content for public surfaces (hero, banners, About, etc.). Public pages read the
/// block and fall back to safe coded defaults when absent. Rich HTML is sanitized on write.
model ContentBlock {
  id          String   @id @default(cuid())
  key         String
  locale      String   @default("en")
  content     String
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, locale])
  @@index([key])
}

// ===== Member Information Form (public intake) =====

enum MemberInfoStatus {
  NEW
  REVIEWED
  APPROVED
  ARCHIVED
}

/// Secure household/member information submitted from the public "Member Information Form".
/// The full submission (names, home address, children + birth dates, baptism/join years,
/// ministry involvement, and optional employment) is app-encrypted at rest in `payloadEnc`;
/// only a family label, best-effort contact email, and workflow fields are kept in clear for
/// the admin review inbox. Staff review a submission and update the member records from it.
model MemberInfoSubmission {
  id                 String           @id @default(cuid())
  householdName      String
  contactEmail       String?
  status             MemberInfoStatus @default(NEW)
  consent            Boolean          @default(false)
  payloadEnc         String
  invitedEmail       String? // set when the form was opened from an emailed invite
  reviewedById       String?
  reviewedAt         DateTime?
  createdHouseholdId String? // household provisioned on approval
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, createdAt])
}

/// An emailed invitation to fill out the public Member Information Form. Lets staff
/// send the form to anyone and (via the token) tie the resulting submission back to
/// the invite. Sending email is best-effort; a copyable link always works.
model MemberInfoInvite {
  id              String    @id @default(cuid())
  email           String
  emailNormalized String
  note            String?
  tokenDigest     String    @unique
  sentById        String?
  submissionId    String?
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([emailNormalized])
}

// ===== Monthly Newsletter (church-wide editorial publication) =====
// A separate product from the Weekly Bulletin (WeeklyPacket). One issue per calendar month,
// department-contributed, Admin/Communications-controlled, rendered to both a member email and a
// premium public web edition from one content model, then archived. Mirrors the WeeklyPacket
// architecture (dated publication + submissions + readiness + reminders + distribution ledger +
// optimistic `version` concurrency); it does NOT fork or replace it.

/// Issue lifecycle (§5). Reconciles the directive's model: COLLECTING_CONTENT→COLLECTING,
/// CONTENT_REVIEW+DESIGN_REVIEW→IN_REVIEW, READY_FOR_APPROVAL→READY. Transitions only per the
/// pure ALLOWED graph in lib/newsletter.ts; several edges may step back one stage.
enum NewsletterIssueStatus {
  DRAFT
  COLLECTING
  IN_REVIEW
  READY
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

/// Department submission lifecycle (§9). NOT_STARTED is derived (no row exists). Canonical flow:
///   DRAFT → SUBMITTED → UNDER_REVIEW → APPROVED → ADDED_TO_ISSUE
///   SUBMITTED/UNDER_REVIEW → CHANGES_REQUESTED → (resubmit) SUBMITTED
///   SUBMITTED/UNDER_REVIEW → DECLINED (terminal)
enum NewsletterSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  ADDED_TO_ISSUE
  DECLINED
}

/// Editorial content type of a department submission (§8).
enum NewsletterContentType {
  NEWS
  EVENT
  ANNOUNCEMENT
  MINISTRY_STORY
  ACCOMPLISHMENT
  VOLUNTEER
  TESTIMONY
  OUTREACH
  OTHER
}

/// Controlled modular section types for the editorial builder (§13/§14). The layout is
/// system-owned; editors add/remove/reorder/hide/edit content, not layout fundamentals.
enum NewsletterSectionType {
  HERO
  PASTOR_MESSAGE
  FEATURED_STORY
  CHURCH_LIFE
  MINISTRY_SPOTLIGHT
  MEMBER_HIGHLIGHT
  COMMUNITY_MISSION
  UPCOMING_EVENTS
  PHOTO_STORY
  BUILDING_UPDATE
  SERVE_INVOLVED
  CTA
  STAY_CONNECTED
  FOOTER
}

/// One newsletter issue per calendar month (`monthStart` = first-of-month at UTC midnight, unique).
/// Readiness is a pure calculation persisted for display; `version` guards concurrent review/publish.
model NewsletterIssue {
  id                String                @id @default(cuid())
  monthStart        DateTime              @unique
  slug              String                @unique // YYYY-MM
  status            NewsletterIssueStatus @default(DRAFT)
  title             String? // internal issue name
  coverHeadline     String? // editorial cover headline
  theme             String?
  coverImageUrl     String?
  coverImageAlt     String?
  pastorMessageHtml String? // sanitized before store
  pastorMessageBy   String?

  // Configurable monthly cadence (§6). Defaulted to the 15th/20th/22nd on create.
  requestAt            DateTime?
  reminderAt           DateTime?
  submissionDeadlineAt DateTime?

  audienceSegment String    @default("ACTIVE_MEMBERS") // resolved via lib/segments
  scheduledSendAt DateTime?
  testEmailSentAt DateTime?
  approvedById    String?
  approvedAt      DateTime?
  publishedAt     DateTime? // email sent + web live
  webPublishedAt  DateTime?
  archivedAt      DateTime?

  readinessScore Int      @default(0)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions   NewsletterSubmission[]
  sections      NewsletterSection[]
  reminders     NewsletterReminder[]
  distributions NewsletterDistribution[]

  @@index([status, monthStart])
}

/// A single department contribution to an issue. Submitter/reviewer are scalar ids for audit/display
/// (no FK, matching the PacketSubmission/AccountRequest pattern). `eventId` links a canonical Calendar
/// event by id (resolved in queries; not a FK) so event data is never duplicated (§16).
model NewsletterSubmission {
  id            String                     @id @default(cuid())
  issueId       String
  issue         NewsletterIssue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  ministryId    String?
  ministry      Ministry?                  @relation("NewsletterSubmissionMinistry", fields: [ministryId], references: [id])
  submittedById String?
  status        NewsletterSubmissionStatus @default(DRAFT)
  version       Int                        @default(0)

  contentType     NewsletterContentType @default(NEWS)
  title           String
  body            String? // what the department wants to share (plain text)
  summary         String? // short editorial summary
  fullContentHtml String? // sanitized rich detail (optional)

  eventStartAt DateTime?
  eventId      String? // canonical Calendar Event id (plain reference)
  location     String?

  ctaLabel    String?
  ctaUrl      String?
  externalUrl String?

  internalNotes String? // note to Communications; never rendered publicly
  reviewNote    String? // feedback shown to the department head
  reviewedById  String?

  featured  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  images    NewsletterImage[]

  @@index([issueId, status])
  @@index([ministryId])
  @@index([submittedById])
}

/// A controlled builder block on an issue (§13). `submissionId` may feature an approved submission;
/// `eventId` may reference a canonical event; `config` holds flexible per-type data (e.g. event id list).
model NewsletterSection {
  id           String                @id @default(cuid())
  issueId      String
  issue        NewsletterIssue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  type         NewsletterSectionType
  title        String?
  subtitle     String?
  bodyHtml     String? // sanitized before store
  imageUrl     String?
  imageAlt     String?
  ctaLabel     String?
  ctaUrl       String?
  submissionId String?
  eventId      String?
  config       Json?
  sortOrder    Int                   @default(0)
  hidden       Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  images       NewsletterImage[]

  @@index([issueId, sortOrder])
}

/// Multiple images for a submission or section (§8/§32). Belongs to exactly one parent.
model NewsletterImage {
  id           String                @id @default(cuid())
  submissionId String?
  submission   NewsletterSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sectionId    String?
  section      NewsletterSection?    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  url          String
  alt          String?
  caption      String?
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())

  @@index([submissionId])
  @@index([sectionId])
}

/// Idempotency + audit ledger for the monthly content-request/reminder crons (§10). One row per
/// (issue, kind, recipient) guarantees a cron re-run never double-sends. kind = REQUEST | REMINDER.
model NewsletterReminder {
  id         String          @id @default(cuid())
  issueId    String
  issue      NewsletterIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  kind       String // REQUEST | REMINDER
  userId     String
  ministryId String?
  sentAt     DateTime        @default(now())

  @@unique([issueId, kind, userId])
  @@index([issueId, kind])
}

/// Member-distribution ledger (§20/§27). Unique per (issue, channel) so the send is idempotent: a
/// retry/duplicate run finds the existing record and no-ops. channel = EMAIL.
model NewsletterDistribution {
  id              String          @id @default(cuid())
  issueId         String
  issue           NewsletterIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  channel         String // EMAIL
  status          String          @default("PENDING") // PENDING | SENT | FAILED
  recipientCount  Int             @default(0)
  sentCount       Int             @default(0)
  suppressedCount Int             @default(0)
  scheduledFor    DateTime?
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  error           String?

  @@unique([issueId, channel])
  @@index([issueId])
}
